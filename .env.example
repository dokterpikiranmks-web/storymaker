# ════════════════════════════════════════════════════════════════════
#  Story Maker — environment template (copy to .env and fill in)
#  Every service below has a $0 free tier.
# ════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────
# Local Postgres or the Supabase Postgres connection string
# (Supabase → Project Settings → Database → Connection string → URI).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Google Gemini (AI Brain, free tier via Google AI Studio) ───────
GEMINI_API_KEY=
# Optional: force a cascade order (comma separated). Leave empty for autodetect.
# GEMINI_MODEL_PRIORITY=gemini-2.5-flash,gemini-2.5-flash-lite
# Base cooldown (seconds) applied to a model after HTTP 429. PRD default = 60.
GEMINI_COOLDOWN_SECONDS=60
# Per-request timeout (ms) before the engine fails over to the next model.
GEMINI_TIMEOUT_MS=45000

# ── Supabase (optional — Storage bucket for rendered PNG/JPEG) ─────
# Without these, rendered images are stored in Postgres (story_assets table).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=story-assets

# ── App ─────────────────────────────────────────────────────────────
# Public base URL (used for absolute image URLs sent to Instagram / the daemon).
APP_URL=http://localhost:3000
# Timezone used to turn target_time (07:15, 12:30, 18:45, 21:30) into real timestamps (WITA / GMT+8).
APP_TIMEZONE=Asia/Makassar
# Optional passcode that protects the dashboard + APIs (strongly recommended in production).
DASHBOARD_PASSCODE=
# Shared secret for the local WhatsApp daemon (/api/worker/*). Generate: openssl rand -hex 32
WORKER_SECRET=
# Optional secret for /api/cron/dispatch (Vercel Cron sends it as Bearer token).
CRON_SECRET=

# ── Persona defaults (can also be edited in the dashboard) ─────────
CREATOR_NAME=
CREATOR_HANDLE=
CTA_KEYWORD=RESET

# ── Instagram (Meta Graph API — Content Publishing, Business account) ─
IG_USER_ID=
IG_ACCESS_TOKEN=
# graph.instagram.com (Instagram Login) or graph.facebook.com (Facebook Login)
IG_GRAPH_HOST=graph.instagram.com
META_GRAPH_API_VERSION=v24.0
