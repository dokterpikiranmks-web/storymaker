# ── Story Maker WhatsApp daemon ─────────────────────────────────────
# Base URL of the Story Maker web portal (Vercel URL in production).
STORY_MAKER_URL=http://localhost:3000
# MUST equal WORKER_SECRET on the server. Generate: openssl rand -hex 32
WORKER_SECRET=
# Polling interval (seconds). PRD default = 60.
POLL_INTERVAL_SECONDS=60
# Optional: limit who sees your Status (comma separated phone numbers, e.g. 62812xxxx,62813xxxx).
# Empty = every contact synced from your WhatsApp account.
WA_STATUS_AUDIENCE=
# Also trigger Instagram publishing for due slides (server does the Graph API call).
DISPATCH_INSTAGRAM=true
# true = simulate posting (no WhatsApp message is sent) — great for testing the pipeline.
DRY_RUN=false
# Baileys log level: silent | error | warn | info | debug
LOG_LEVEL=silent
# Session folder (keep private — it IS your WhatsApp login)
WA_AUTH_DIR=./auth_info_baileys
